# =============================================================================
# AulaSmart - Variables de entorno para PRODUCCION (Railway)
# =============================================================================
# NO subir este archivo a Git. Mantenerlo local y configurar las variables
# directamente en el dashboard de Railway.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=your-railway-postgres-host
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
DB_USERNAME=postgres
DB_PASSWORD=your-secure-password

# --- Seguridad JWT ---
JWT_SECRET_KEY=your-very-long-and-secure-jwt-secret-key-min-256-bits

# --- Groq AI (chat-service + incidencia-service) ---
API_KEY_GROQ=your-groq-api-key
GROQ_API_KEY_CHAT=your-groq-api-key

# --- Spring AI (chat-service) ---
SPRING_AI_OPENAI_API_KEY=your-groq-api-key
SPRING_AI_OPENAI_BASE_URL=https://api.groq.com/openai/v1
SPRING_AI_OPENAI_MODEL=openai/gpt-oss-120b

# --- URLs entre microservicios (Railway asigna dominios automaticamente) ---
URL_SERVICIO_ASISTENCIA=http://aula-service.railway.internal:8082
URL_SERVICIO_RESERVA=http://reserva-service.railway.internal:8080

# --- Perfil activo ---
SPRING_PROFILES_ACTIVE=prod

# --- Cache del chat ---
CHAT_CACHE_ENABLED=true
