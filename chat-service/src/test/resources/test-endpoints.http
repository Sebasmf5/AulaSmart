POST {{baseUrl}}/api/v1/chat
Content-Type: application/json
Authorization: Bearer {{jwtToken}}

{
  "mensaje": "reservar el auditorio principal el 2026-05-22 de 08:00 a 12:00 para evento de graduación"
}

