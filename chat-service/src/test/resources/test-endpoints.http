# ESCENARIO 9: CONDICIÓN DE CARRERA (BLOQUEO OPTIMISTA)
# ═══════════════════════════════════════════════════════════════════════════════

### TC18: Reserva concurrente (simulación manual)
# Para probar condiciones de carrera real, ejecutar dos requests simultáneas
# al mismo aula/hora desde dos terminales diferentes.
#
# Terminal 1:
# POST {{baseUrl}}/api/v1/chat
# { "mensaje": "reservar aula B104 el 2026-05-25 de 08:00 a 10:00 para evento A" }
#
# Terminal 2 (al mismo tiempo):
# POST {{baseUrl}}/api/v1/chat
# { "mensaje": "reservar aula B104 el 2026-05-25 de 08:00 a 10:00 para evento B" }
#
# Resultado esperado: Una CONFIRMADA, la otra RECHAZADA por solapamiento
# (El índice GIST en PostgreSQL previene el insert solapado)

# ═══════════════════════════════════════════════════════════════════════════════
# ESCENARIO 10: VERIFICACIÓN DE PERSISTENCIA (JWT)
# ═══════════════════════════════════════════════════════════════════════════════

### TC19: Verificar que la reserva guardó el rol y nombre del JWT
# Después de hacer una reserva exitosa (TC05), verificar en la BD:
#
# SELECT id_reserva, aula_id, id_solicitante, rol_solicitante,
#        nombre_usuario_responsable, titulo
# FROM reservas
# ORDER BY id_reserva DESC
# LIMIT 1;
#
# Resultado esperado:
#   id_solicitante: debe coincidir con el 'sub' del JWT
#   rol_solicitante: DOCENTE / ESTUDIANTE / ADMINISTRATIVO
#   nombre_usuario_responsable: nombre del usuario en el JWT
#   titulo: "reunión de facultad" (el motivo que dio el usuario)

# ═══════════════════════════════════════════════════════════════════════════════
# COMANDOS ADICIONALES PARA VERIFICACIÓN
# ═══════════════════════════════════════════════════════════════════════════════

### Verificar reservas de un aula (endpoint directo del reserva-service)
GET http://localhost:8080/api/v1/reserva-service/reservas/aula/1/agregadas
Authorization: Bearer {{jwtToken}}

### Verificar aulas ocupadas en un rango (endpoint directo del reserva-service)
GET http://localhost:8080/api/v1/reserva-service/reservas/ocupadas?fecha=2026-05-20&horaInicio=08:00&horaFin=10:00
Authorization: Bearer {{jwtToken}}

### Listar todas las aulas (endpoint directo del aula-service)
GET http://localhost:8082/api/v1/aula-service/aulas
Authorization: Bearer {{jwtToken}}

### Listar aulas sincronizadas con SIGA
GET http://localhost:8082/api/v1/aula-service/aulas/sincronizadas-siga
Authorization: Bearer {{jwtToken}}

# ============================================================================
# INSTRUCCIONES PARA OBTENER JWT
# ============================================================================
# 1. Registrar usuario (si no existe):
#    POST http://localhost:8084/api/v1/usuarios/register
#    {"nombre":"Docente","apellido":"Test","email":"docente@test.com","password":"Test123!","rol":"Docente"}
#
# 2. Login:
#    POST http://localhost:8084/api/v1/usuarios/login
#    {"email":"docente@test.com","password":"Test123!"}
#
# 3. Copiar el token de la respuesta y pegarlo en {{jwtToken}}
# ============================================================================
